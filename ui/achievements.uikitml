<panel>
  <div name="root" background-color="#000a14" border-radius="12" padding="16" flex-direction="column" align-items="center" gap="4">
    <div font-size="20" color="#ffcc33" font-weight="bold">ACHIEVEMENTS</div>
    <div name="ach-count" font-size="12" color="#8899aa">0/20</div>
    <div flex-direction="column" gap="4" padding-top="4" width="100%">
      <div flex-direction="column" gap="2">
        <div name="ach-name-0" font-size="12" color="#00ffff"></div>
        <div name="ach-desc-0" font-size="10" color="#668899"></div>
      </div>
      <div flex-direction="column" gap="2">
        <div name="ach-name-1" font-size="12" color="#00ffff"></div>
        <div name="ach-desc-1" font-size="10" color="#668899"></div>
      </div>
      <div flex-direction="column" gap="2">
        <div name="ach-name-2" font-size="12" color="#00ffff"></div>
        <div name="ach-desc-2" font-size="10" color="#668899"></div>
      </div>
      <div flex-direction="column" gap="2">
        <div name="ach-name-3" font-size="12" color="#00ffff"></div>
        <div name="ach-desc-3" font-size="10" color="#668899"></div>
      </div>
      <div flex-direction="column" gap="2">
        <div name="ach-name-4" font-size="12" color="#00ffff"></div>
        <div name="ach-desc-4" font-size="10" color="#668899"></div>
      </div>
    </div>
    <div name="ach-page" font-size="11" color="#8899aa" padding-top="4">Page 1/4</div>
    <div flex-direction="row" gap="8">
      <div name="btn-ach-prev" background-color="#222233" border-radius="4" padding="6" cursor="pointer" font-size="11" color="#8899aa">Prev</div>
      <div name="btn-ach-next" background-color="#222233" border-radius="4" padding="6" cursor="pointer" font-size="11" color="#8899aa">Next</div>
    </div>
    <div name="btn-ach-back" background-color="#222233" border-radius="4" padding="8" cursor="pointer" font-size="12" color="#8899aa" margin-top="4">BACK</div>
  </div>
</panel>
