<panel>
  <div name="root" flex-direction="column" align-items="center" gap="2">
    <div flex-direction="row" justify-content="space-between" padding="6" gap="8" width="100%">
      <div name="score" font-size="14" color="#00ffff" font-weight="bold">SCORE: 0</div>
      <div name="wave" font-size="14" color="#ffcc33">WAVE: 1</div>
      <div name="humans" font-size="14" color="#33ff66">HUMANS: 10</div>
      <div name="lives" font-size="14" color="#ff6666">LIVES: 3</div>
      <div name="bombs" font-size="14" color="#ff8800">BOMBS: 3</div>
      <div name="hyperspace" font-size="12" color="#aa66ff">HS: READY</div>
      <div name="combo" font-size="14" color="#ffffff"></div>
      <div name="timer" font-size="14" color="#ffcc33"></div>
    </div>
    <div name="wave-announce" font-size="22" color="#ffcc33" font-weight="bold"></div>
  </div>
</panel>
