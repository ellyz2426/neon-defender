<panel>
  <div name="root" background-color="#000a14" border-radius="12" padding="16" flex-direction="column" align-items="center" gap="8">
    <div name="title" font-size="28" color="#00ffff" font-weight="bold">NEON DEFENDER VR</div>
    <div font-size="12" color="#668899">Side-Scrolling Rescue Shooter</div>
    <div flex-direction="column" gap="6" padding-top="10" align-items="center">
      <div name="btn-arcade" background-color="#004466" border-radius="6" padding="8" hover-background-color="#006688" cursor="pointer" font-size="14" color="#00ffff">ARCADE MODE</div>
      <div name="btn-speed" background-color="#444400" border-radius="6" padding="8" hover-background-color="#666600" cursor="pointer" font-size="14" color="#ffcc33">SPEED MODE (120s)</div>
      <div name="btn-zen" background-color="#003300" border-radius="6" padding="8" hover-background-color="#005500" cursor="pointer" font-size="14" color="#33ff66">ZEN MODE</div>
      <div name="btn-challenge" background-color="#440022" border-radius="6" padding="8" hover-background-color="#660033" cursor="pointer" font-size="14" color="#ff33ff">CHALLENGE MODE</div>
    </div>
    <div flex-direction="row" gap="8" padding-top="8">
      <div name="btn-settings" background-color="#222233" border-radius="4" padding="6" cursor="pointer" font-size="11" color="#8899aa">Settings</div>
      <div name="btn-tutorial" background-color="#222233" border-radius="4" padding="6" cursor="pointer" font-size="11" color="#8899aa">How to Play</div>
    </div>
    <div flex-direction="row" gap="8">
      <div name="btn-stats" background-color="#222233" border-radius="4" padding="6" cursor="pointer" font-size="11" color="#8899aa">Stats</div>
      <div name="btn-achievements" background-color="#222233" border-radius="4" padding="6" cursor="pointer" font-size="11" color="#8899aa">Achievements</div>
    </div>
  </div>
</panel>
